# Copy this file to .env. The application loads it at startup via spring-dotenv.
# Ollama must be running locally; no API key is required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
AI_SYSTEM_PROMPT=You are a helpful, concise assistant.

# Optional SQLite database path
#SQLITE_DB_PATH=chatbot.db
